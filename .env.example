# ==============================================================================
# NECTAR LABS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copia este archivo a .env.local, .env.staging o .env.prod y define los valores reales.
# NUNCA subas claves secretas o credenciales de producción al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & SERVIDOR
# ------------------------------------------------------------------------------
DEBUG=True
ENVIRONMENT=local
SECRET_KEY=your_django_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (POSTGRESQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nectarlabs
# O configuración granular:
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. CACHÉ & MENSAJERÍA (REDIS)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1

# ------------------------------------------------------------------------------
# 4. MICROSERVICIO DE TIEMPO REAL (SOCKET.IO / REALTIME BRIDGE)
# ------------------------------------------------------------------------------
REALTIME_INTERNAL_URL=http://realtime:4001
REALTIME_INTERNAL_SECRET=your_realtime_internal_secret_here
INTERNAL_SECRET=your_realtime_internal_secret_here

# ------------------------------------------------------------------------------
# 5. ALMACENAMIENTO MULTIMEDIA (CLOUDINARY & CLOUDFLARE R2)
# ------------------------------------------------------------------------------
# Cloudinary (Imágenes y activos estáticos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 / S3 (Documentos, contratos y firmas digitales)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nectarlabs
R2_S3_ENDPOINT_URL=
R2_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# 6. PASARELA DE PAGOS (STRIPE)
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 7. PROVEEDORES DE CORREO SMTP (MULTI-GATEWAY)
# ------------------------------------------------------------------------------
# Gateway A: Zoho Mail (Transaccional y soporte técnico por defecto)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=soporte@nectarlabs.dev
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nectar Labs <soporte@nectarlabs.dev>
EMAIL_SUPPORT=Nectar Labs Soporte <soporte@nectarlabs.dev>
EMAIL_NEWSLETTER=Nectar Labs <hola@nectarlabs.dev>
EMAIL_CONTACT=Nectar Labs <contacto@nectarlabs.dev>
EMAIL_BILLING=Nectar Labs Facturación <facturacion@nectarlabs.dev>

# Gateway B: Brevo SMTP Relay (Newsletter y marketing inicial)
BREVO_EMAIL_HOST=smtp-relay.brevo.com
BREVO_EMAIL_PORT=587
BREVO_EMAIL_HOST_USER=
BREVO_EMAIL_HOST_PASSWORD=
BREVO_DEFAULT_FROM_EMAIL=Nectar Labs <no-reply@nectarlabs.dev>

# Gateway C: Amazon SES SMTP Relay (Envíos masivos y respaldo)
SES_EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
SES_EMAIL_PORT=587
SES_EMAIL_HOST_USER=
SES_EMAIL_HOST_PASSWORD=
SES_DEFAULT_FROM_EMAIL=Nectar Labs <no-reply@nectarlabs.dev>

# ------------------------------------------------------------------------------
# 8. FACTURACIÓN ELECTRÓNICA CFDI 4.0 SAT (FACTURAPI)
# ------------------------------------------------------------------------------
PAC_PROVIDER=facturapi
PAC_ENVIRONMENT=sandbox
PAC_LIVE_KEY=sk_live_...
PAC_TEST_KEY=sk_test_...
PAC_API_KEY=sk_test_...
FACTURAPI_USER_KEY=sk_user_...
FACTURAPI_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 9. LOGÍSTICA & ENVÍOS (ENVIA.COM & SKYDROPX PRO)
# ------------------------------------------------------------------------------
# Envia.com Master / Sandbox Credentials
ENVIA_ENVIRONMENT=sandbox
ENVIA_PRODUCTION_TOKEN=
ENVIA_SANDBOX_TOKEN=
ENVIA_WEBHOOK_SECRET=
ENVIA_WEBHOOK_TOKENS=

# Skydropx Pro Master / Sandbox Credentials (OAuth2)
SKYDROPX_ENVIRONMENT=staging
SKYDROPX_PROD_API_KEY=
SKYDROPX_PROD_API_SECRET=
SKYDROPX_SANDBOX_API_KEY=
SKYDROPX_SANDBOX_API_SECRET=
SKYDROPX_WEBHOOK_SECRET=

# Finanzas y Billetera Logística
MIN_SHIPPING_WALLET_BALANCE=300.00


# ------------------------------------------------------------------------------
# 10. INTELIGENCIA ARTIFICIAL (GROQ CLOUD API)
# ------------------------------------------------------------------------------
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 11. FRONTEND & APIS (NEXT.JS)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
INTERNAL_API_URL=http://backend:8000/api
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 12. SEGURIDAD / CORS & CSRF
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
